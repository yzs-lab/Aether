diff --git a/python/sglang/srt/observability/aether_metrics.py b/python/sglang/srt/observability/aether_metrics.py
new file mode 100644
index 000000000..9eea4627a
--- /dev/null
+++ b/python/sglang/srt/observability/aether_metrics.py
@@ -0,0 +1,196 @@
+"""Aether metrics registry for IPW experiment collection.
+
+This module is intentionally lightweight and disabled unless
+``--enable-aether-metrics`` is passed. It records request-level counters from
+already-produced SGLang response metadata and exposes a JSON snapshot for
+external experiment runners.
+"""
+
+from __future__ import annotations
+
+import time
+from collections import deque
+from threading import Lock
+from typing import Any, Deque, Dict, Mapping, Optional
+
+from sglang.srt.constants import HEALTH_CHECK_RID_PREFIX
+
+
+def _as_int(value: Any) -> int:
+    if value is None:
+        return 0
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        return 0
+
+
+def _as_float(value: Any) -> float:
+    if value is None:
+        return 0.0
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+def _truthy(value: Any) -> bool:
+    return bool(value)
+
+
+class AetherMetricsRegistry:
+    def __init__(self) -> None:
+        self._lock = Lock()
+        self.reset()
+
+    def reset(self) -> None:
+        self.enabled = False
+        self.started_at_unix_s = time.time()
+        self.server: Dict[str, Any] = {}
+        self.events: Deque[Dict[str, Any]] = deque(maxlen=1024)
+        self.request_count = 0
+        self.prompt_tokens_total = 0
+        self.completion_tokens_total = 0
+        self.total_tokens_total = 0
+        self.e2e_latency_sum_s = 0.0
+        self.ttft_sum_s = 0.0
+        self.tbt_sum_s = 0.0
+        self.last_request_unix_s: Optional[float] = None
+
+    def configure(self, server_args: Any) -> None:
+        retain_events = max(
+            1, _as_int(getattr(server_args, "aether_metrics_retain_events", 1024))
+        )
+        with self._lock:
+            self.reset()
+            self.enabled = _truthy(getattr(server_args, "enable_aether_metrics", False))
+            self.events = deque(maxlen=retain_events)
+            self.server = {
+                "model_path": getattr(server_args, "model_path", None),
+                "served_model_name": getattr(server_args, "served_model_name", None),
+                "tokenizer_path": getattr(server_args, "tokenizer_path", None),
+                "device": getattr(server_args, "device", None),
+                "context_length": getattr(server_args, "context_length", None),
+                "max_total_tokens": getattr(server_args, "max_total_tokens", None),
+                "tensor_parallel_size": getattr(server_args, "tp_size", None),
+                "data_parallel_size": getattr(server_args, "dp_size", None),
+                "kv_cache_dtype": getattr(server_args, "kv_cache_dtype", None),
+                "enable_metrics": getattr(server_args, "enable_metrics", None),
+            }
+
+    def record_request(self, obj: Any, out_dict: Mapping[str, Any]) -> None:
+        if not self.enabled:
+            return
+
+        rid = getattr(obj, "rid", None)
+        if isinstance(rid, str) and HEALTH_CHECK_RID_PREFIX in rid:
+            return
+        if not getattr(obj, "log_metrics", True):
+            return
+
+        meta_info = out_dict.get("meta_info", {})
+        if not isinstance(meta_info, Mapping):
+            meta_info = {}
+
+        prompt_tokens = _as_int(
+            meta_info.get("prompt_tokens") or meta_info.get("input_tokens")
+        )
+        completion_tokens = _as_int(
+            meta_info.get("completion_tokens") or meta_info.get("output_tokens")
+        )
+        if completion_tokens == 0 and isinstance(out_dict.get("output_ids"), list):
+            completion_tokens = len(out_dict["output_ids"])
+        total_tokens = (
+            _as_int(meta_info.get("total_tokens")) or prompt_tokens + completion_tokens
+        )
+        e2e_latency_s = _as_float(
+            meta_info.get("e2e_latency") or meta_info.get("latency")
+        )
+        ttft_s = _as_float(
+            meta_info.get("ttft")
+            or meta_info.get("time_to_first_token")
+            or meta_info.get("first_token_latency")
+            or meta_info.get("first_token_latency_s")
+        )
+        tbt_s = _as_float(
+            meta_info.get("tbt")
+            or meta_info.get("inter_token_latency")
+            or meta_info.get("decode_token_latency")
+        )
+        now = time.time()
+        event = {
+            "type": "request",
+            "timestamp_unix_s": now,
+            "rid": rid,
+            "prompt_tokens": prompt_tokens,
+            "completion_tokens": completion_tokens,
+            "total_tokens": total_tokens,
+            "e2e_latency_s": e2e_latency_s,
+            "ttft_s": ttft_s,
+            "tbt_s": tbt_s,
+            "finish_reason": meta_info.get("finish_reason"),
+        }
+
+        with self._lock:
+            self.request_count += 1
+            self.prompt_tokens_total += prompt_tokens
+            self.completion_tokens_total += completion_tokens
+            self.total_tokens_total += total_tokens
+            self.e2e_latency_sum_s += e2e_latency_s
+            self.ttft_sum_s += ttft_s
+            self.tbt_sum_s += tbt_s
+            self.last_request_unix_s = now
+            self.events.append(event)
+
+    def snapshot(
+        self,
+        scheduler_info: Optional[Mapping[str, Any]] = None,
+        internal_states: Optional[Any] = None,
+    ) -> Dict[str, Any]:
+        with self._lock:
+            request_count = self.request_count
+            summary = {
+                "request_count": request_count,
+                "prompt_tokens_total": self.prompt_tokens_total,
+                "completion_tokens_total": self.completion_tokens_total,
+                "total_tokens_total": self.total_tokens_total,
+                "e2e_latency_sum_s": round(self.e2e_latency_sum_s, 9),
+                "e2e_latency_avg_s": round(self.e2e_latency_sum_s / request_count, 9)
+                if request_count
+                else 0.0,
+                "ttft_avg_s": round(self.ttft_sum_s / request_count, 9)
+                if request_count
+                else 0.0,
+                "tbt_avg_s": round(self.tbt_sum_s / request_count, 9)
+                if request_count
+                else 0.0,
+                "last_request_unix_s": self.last_request_unix_s,
+            }
+            return {
+                "schema_version": 1,
+                "enabled": self.enabled,
+                "started_at_unix_s": self.started_at_unix_s,
+                "server": dict(self.server),
+                "summary": summary,
+                "events": list(self.events),
+                "scheduler_info": dict(scheduler_info or {}),
+                "internal_states": internal_states or [],
+            }
+
+
+_REGISTRY = AetherMetricsRegistry()
+
+
+def configure_aether_metrics(server_args: Any) -> None:
+    _REGISTRY.configure(server_args)
+
+
+def record_aether_request(obj: Any, out_dict: Mapping[str, Any]) -> None:
+    _REGISTRY.record_request(obj, out_dict)
+
+
+def snapshot_aether_metrics(
+    scheduler_info: Optional[Mapping[str, Any]] = None,
+    internal_states: Optional[Any] = None,
+) -> Dict[str, Any]:
+    return _REGISTRY.snapshot(scheduler_info=scheduler_info, internal_states=internal_states)
